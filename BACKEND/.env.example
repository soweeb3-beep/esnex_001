# Backend environment variables
MONGO_URI=mongodb://127.0.0.1:27017/esnex
PORT=5000
JWT_SECRET=your_jwt_secret_here
ADMIN_EMAIL=admin@esnex.com
ADMIN_NAME=ESNEX Admin
ADMIN_PASSWORD=Admin1234
ADMIN_SIGNUP_CODE=ESNEX_ADMIN_CODE_2026

# OpenAI settings for theory grading
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Gemini settings for theory grading
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_AUTH_METHOD=apiKey
# Optional: use a custom Gemini REST endpoint if required
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
